# machash - hash strings into MAC addresses.
#
# The binary is a single-file static universal binary built with
# cosmocc. The cosmocc helper tools are Cosmopolitan (APE)
# binaries. A build host has no APE binfmt handler, so each helper
# is run through the APE loader for this architecture. At install
# time the APE handler is registered so the binary can run on the
# host.

pkgname=machash
pkgver=1.0.1
pkgrel=0
pkgdesc="Hash arbitrary strings into MAC addresses"
url="https://github.com/MrDrMcCoy/machash"
license="BSD-3-Clause"
makedepends="curl unzip"
_download="https://github.com/MrDrMcCoy/machash/releases/download/v${pkgver}"
source="${_download}/${pkgname}-${pkgver}.tar.gz"
builddir="${srcdir}/${pkgname}-${pkgver}"

_prepare_cosmocc() {
	cd "${builddir}"
	curl -fsSL -o cosmocc.zip \
		"https://cosmo.zip/pub/cosmocc/cosmocc-4.0.2.zip"
	mkdir -p cosmo
	unzip -q cosmocc.zip -d cosmo
	local t
	for t in apelink fixupobj pecheck mktemper \
		x86_64-linux-cosmo-gcc aarch64-linux-cosmo-gcc; do
		mv "cosmo/bin/${t}" "cosmo/bin/${t}.ape"
		{
			printf '#!/bin/sh\n'
			printf 'exec "$(dirname "$0")/ape-%s.elf" ' "$(uname -m)"
			printf '"$(dirname "$0")/%s.ape" "$@"\n' "${t}"
		} > "cosmo/bin/${t}"
		chmod +x "cosmo/bin/${t}"
	done
}

build() {
	_prepare_cosmocc
	make build CC="${PWD}/cosmo/bin/cosmocc"
}

package() {
	default_install
	install -Dm755 "${builddir}/dist/machash" "${pkgdir}/usr/bin/machash"
	install -Dm755 "${builddir}/cosmo/bin/ape-$(uname -m).elf" \
		"${pkgdir}/usr/lib/machash/ape"
	install -Dm644 "${builddir}/man/machash.1" \
		"${pkgdir}/usr/share/man/man1/machash.1"
	install -Dm644 "${builddir}/LICENSE" \
		"${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -Dm644 "${builddir}/readme.md" \
		"${pkgdir}/usr/share/doc/${pkgname}/readme.md"
}

_register_ape() {
	[ -e /proc/sys/fs/binfmt_misc/APE ] && return 0
	if [ ! -d /proc/sys/fs/binfmt_misc ]; then
		mount -t binfmt_misc none /proc/sys/fs/binfmt_misc 2>/dev/null
	fi
	if [ -d /proc/sys/fs/binfmt_misc ]; then
		echo ':APE:M::MZqFpD::/usr/lib/machash/ape:' \
			> /proc/sys/fs/binfmt_misc/register
	else
		echo "warning: could not register the APE handler; " \
			"machash needs it to run" >&2
	fi
}

post-install() {
	_register_ape
}

post-upgrade() {
	_register_ape
}

post-remove() {
	if [ -r /proc/sys/fs/binfmt_misc/APE ]; then
		local interp
		interp=$(awk -F: '{print $NF}' /proc/sys/fs/binfmt_misc/APE)
		if [ "${interp}" = "/usr/lib/machash/ape" ]; then
			echo '-APE' > /proc/sys/fs/binfmt_misc/register
		fi
	fi
}
